# Copy this file to .env and fill in your real values.
# Find credentials in the Box Developer Console:
# https://app.box.com/developers/console

# CCG app credentials (Configuration tab)
BOX_CLIENT_ID=your_client_id
BOX_CLIENT_SECRET=your_client_secret

# Your enterprise ID (account icon > Copy Enterprise ID)
BOX_ENTERPRISE_ID=your_enterprise_id

# Metadata template key from Admin Console > Metadata > Brand Asset template
# (shown under Template Name after you save the template)
BOX_METADATA_TEMPLATE_KEY=your_metadata_template_key

# Folder IDs of the Brand DAM lifecycle folders
# (from the URL: https://app.box.com/folder/123456789 → 123456789)
# Invite the app's Service Account as Editor on the parent Brand DAM folder.
DRAFT_FOLDER_ID=your_draft_folder_id
CREATIVE_REVIEW_FOLDER_ID=your_creative_review_folder_id
LEGAL_REVIEW_FOLDER_ID=your_legal_review_folder_id
APPROVED_FOLDER_ID=your_approved_folder_id
PUBLISHED_FOLDER_ID=your_published_folder_id
RETIRED_FOLDER_ID=your_retired_folder_id

# Optional: default vendor email for invite_vendor.py
# VENDOR_EMAIL=vendor@example.com
